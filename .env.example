# ── NEXT GENT: App-build- is the shared app engine and the app builder ──
#
# Its own login, Supabase project and store are retired as authorities and
# switched off. Set to "on" only to run the old platform as it was (e.g. to
# move its data out). Off (unset): /login, /signup, /dashboard, /u/* and
# /preview redirect to /retired, and /dashboard/build goes to /build.
APP_BUILD_LEGACY_PLATFORM=

# Paperclip, where the builder publishes manifests (POST /api/store/admin/items).
# Publishing uses the instance admin's own Paperclip session in the browser,
# so Paperclip must list this site in PAPERCLIP_APP_ORIGINS. Empty: the builder
# only downloads the manifest.
NEXT_PUBLIC_PAPERCLIP_URL=
# The store publisher id manifests are published under (lowercase-with-dashes);
# prefills the builder. Item keys are "<publisher>-<app name>".
NEXT_PUBLIC_STORE_PUBLISHER=
# Store item kind for apps. Empty uses the contract's "app"; set it only while
# Paperclip's store does not yet accept that kind.
NEXT_PUBLIC_STORE_APP_KIND=

# Describe-it / speak-it at /build/describe, with no App-build- login: uses only
# the platform AI provider below, and only when this is a positive number of
# generations allowed per client address per hour (per server instance).
# Empty or 0: describe-it is off; building by hand still works.
BUILDER_AI_HOURLY_LIMIT=

# ── Retired platform (read only when APP_BUILD_LEGACY_PLATFORM=on) ──

# Supabase project credentials.
# Create a project at https://supabase.com, then copy these from Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The Ghost relay (gcr-api-clean). "My Ghost" in the dashboard reaches the
# account's box through it. This app and gcr-api-clean must share the same
# Supabase project (one login), and the account must own a business there.
NEXT_PUBLIC_GCR_API_BASE=https://gcr-api-clean.vercel.app

# Public base URL, used to build shareable/QR links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: a platform-wide default AI provider for the "Describe it" app
# builder (voice input works either way, since transcription happens in the
# browser). Any signed-in account can also set their own provider and key in
# Settings > AI, which always takes priority over this default. Without
# either configured, "Describe it" simply does not appear; manual building
# is unaffected. Set at most one provider's variables below.

# Anthropic (Claude)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5

# OpenAI (GPT)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.1

# Google (Gemini)
# GOOGLE_GENERATIVE_AI_API_KEY=
# GOOGLE_MODEL=gemini-3-pro

# OpenRouter (one key, hundreds of models from every major lab)
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=anthropic/claude-sonnet-5

# Any other OpenAI-compatible endpoint: a self-hosted model (Ollama, LM
# Studio, vLLM), Azure OpenAI, or another aggregator.
# CUSTOM_AI_BASE_URL=
# CUSTOM_AI_API_KEY=
# CUSTOM_AI_MODEL=
