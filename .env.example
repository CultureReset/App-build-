# Supabase project credentials.
# Create a project at https://supabase.com, then copy these from Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public base URL, used to build shareable/QR links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: enables the "Describe it" AI app builder (voice input works either
# way, since transcription happens in the browser). Without this the button is
# hidden and manual building still works fully.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
