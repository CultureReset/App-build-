{
  "schema_version": 1,
  "id": "core-faq",
  "name": "FAQ",
  "summary": "Answer the questions before they are asked.",
  "description": "A list of questions and answers that expand when tapped. Cuts down the same messages you answer every week.",
  "version": "1.0.0",
  "publisher": "core",
  "icon": "❓",
  "requires": {
    "platform": "1"
  },
  "runtime": {
    "type": "engine",
    "engine": "1"
  },
  "surfaces": [
    {
      "id": "owner",
      "kind": "dashboard",
      "title": "Manage",
      "path": "/owner",
      "display_modes": [
        "page"
      ]
    },
    {
      "id": "public",
      "kind": "public",
      "title": "Questions",
      "path": "/public",
      "display_modes": [
        "inline",
        "card",
        "page"
      ]
    }
  ],
  "permissions": [
    {
      "id": "business:read",
      "reason": "Shows the questions and answers the business keeps."
    },
    {
      "id": "business:write",
      "reason": "Lets the owner edit the questions and answers from inside this app."
    }
  ],
  "bindings": {
    "faqs": {
      "contract": "faqs.items",
      "access": "read-write"
    }
  },
  "pricing": {
    "model": "free"
  },
  "ui": {
    "sources": {
      "entries": {
        "from": "business",
        "binding": "faqs",
        "label": "Questions",
        "labelSingular": "Question",
        "fields": [
          {
            "key": "question",
            "label": "Question",
            "type": "text",
            "required": true,
            "maxLength": 160
          },
          {
            "key": "answer",
            "label": "Answer",
            "type": "longtext",
            "required": true,
            "maxLength": 1200
          }
        ],
        "title": "question",
        "order": "sort_order",
        "sortable": true
      }
    },
    "views": {
      "owner": [
        {
          "type": "collection",
          "source": "entries"
        }
      ],
      "public": [
        {
          "type": "details",
          "source": "entries",
          "style": "accordion",
          "fields": {
            "summary": "question",
            "body": "answer"
          }
        }
      ]
    }
  }
}
