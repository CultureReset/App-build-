{
  "schema_version": 1,
  "id": "core-gallery",
  "name": "Gallery",
  "summary": "Photos of the work, the room, the product.",
  "description": "A grid of images with optional captions. Useful anywhere the thing you do is easier to show than to describe.",
  "version": "1.0.0",
  "publisher": "core",
  "icon": "🖼️",
  "requires": {
    "platform": "1"
  },
  "runtime": {
    "type": "engine",
    "engine": "1"
  },
  "surfaces": [
    {
      "id": "owner",
      "kind": "dashboard",
      "title": "Manage",
      "path": "/owner",
      "display_modes": [
        "page"
      ]
    },
    {
      "id": "public",
      "kind": "public",
      "title": "Gallery",
      "path": "/public",
      "display_modes": [
        "inline",
        "card",
        "page"
      ]
    }
  ],
  "permissions": [
    {
      "id": "business:read",
      "reason": "Shows the photos the business keeps."
    },
    {
      "id": "business:write",
      "reason": "Lets the owner add, caption and reorder photos from inside this app."
    }
  ],
  "bindings": {
    "media": {
      "contract": "media.images",
      "access": "read-write"
    }
  },
  "pricing": {
    "model": "free"
  },
  "ui": {
    "sources": {
      "photos": {
        "from": "business",
        "binding": "media",
        "label": "Photos",
        "labelSingular": "Photo",
        "fields": [
          {
            "key": "image_url",
            "label": "Image URL",
            "type": "image",
            "required": true
          },
          {
            "key": "caption",
            "label": "Caption",
            "type": "text",
            "maxLength": 120
          },
          {
            "key": "link_url",
            "label": "Links to",
            "type": "url"
          },
          {
            "key": "visible",
            "label": "Visible",
            "type": "boolean",
            "default": true
          }
        ],
        "title": "caption",
        "subtitle": "image_url",
        "order": "sort_order",
        "sortable": true,
        "visibleWhen": "visible"
      }
    },
    "views": {
      "owner": [
        {
          "type": "collection",
          "source": "photos"
        }
      ],
      "public": [
        {
          "type": "images",
          "source": "photos",
          "style": "grid",
          "fields": {
            "image": "image_url",
            "caption": "caption",
            "link": "link_url"
          }
        }
      ]
    }
  }
}
