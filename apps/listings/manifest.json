{
  "schema_version": 1,
  "id": "core-listings",
  "name": "Listings",
  "summary": "Show what you have available, with a way to reach you on every one.",
  "description": "Anything you list: each entry gets a photo, a price per unit, a kind badge, a capacity and its own details. Visitors filter by kind and open the one they are interested in.",
  "version": "1.0.0",
  "publisher": "core",
  "icon": "🏷️",
  "requires": {
    "platform": "1"
  },
  "runtime": {
    "type": "engine",
    "engine": "1"
  },
  "surfaces": [
    {
      "id": "owner",
      "kind": "dashboard",
      "title": "Manage",
      "path": "/owner",
      "display_modes": [
        "page"
      ]
    },
    {
      "id": "public",
      "kind": "public",
      "title": "Listings",
      "path": "/public",
      "display_modes": [
        "inline",
        "card",
        "page"
      ]
    }
  ],
  "permissions": [
    {
      "id": "business:read",
      "reason": "Shows the listings the business keeps, priced in its currency."
    },
    {
      "id": "business:write",
      "reason": "Lets the owner add and edit listings from inside this app."
    }
  ],
  "bindings": {
    "listings": {
      "contract": "listings.items",
      "access": "read-write",
      "fieldMap": {
        "title": "name",
        "price": "price_from",
        "visible": "active"
      }
    },
    "currency": {
      "contract": "business.currency",
      "access": "read"
    }
  },
  "pricing": {
    "model": "free"
  },
  "ui": {
    "format": {
      "currency": {
        "binding": "currency"
      }
    },
    "sources": {
      "catalogue": {
        "from": "business",
        "binding": "listings",
        "label": "Listings",
        "labelSingular": "Listing",
        "fields": [
          {
            "key": "title",
            "label": "Title",
            "type": "text",
            "required": true,
            "maxLength": 120
          },
          {
            "key": "image_url",
            "label": "Photo",
            "type": "image",
            "help": "A link to a photo of the listing."
          },
          {
            "key": "kind",
            "label": "Kind",
            "type": "text",
            "required": true,
            "maxLength": 40,
            "help": "What sort of listing this is: room, service, product… Visitors can filter by it."
          },
          {
            "key": "unit",
            "label": "Unit",
            "type": "text",
            "maxLength": 40,
            "help": "What the price is for: per night, per hour, each."
          },
          {
            "key": "price",
            "label": "Price from",
            "type": "money",
            "min": 0
          },
          {
            "key": "capacity",
            "label": "Capacity",
            "type": "number",
            "min": 0
          },
          {
            "key": "description",
            "label": "Description",
            "type": "longtext",
            "maxLength": 800
          },
          {
            "key": "visible",
            "label": "Visible",
            "type": "boolean",
            "default": true
          }
        ],
        "title": "title",
        "subtitle": "price",
        "order": "sort_order",
        "sortable": true,
        "visibleWhen": "visible"
      }
    },
    "views": {
      "owner": [
        {
          "type": "listing-manager",
          "source": "catalogue",
          "fields": {
            "title": "title",
            "image": "image_url",
            "kind": "kind",
            "price": "price",
            "unit": "unit",
            "capacity": "capacity",
            "description": "description"
          }
        }
      ],
      "public": [
        {
          "type": "listings",
          "source": "catalogue",
          "style": "grid",
          "fields": {
            "title": "title",
            "image": "image_url",
            "kind": "kind",
            "price": "price",
            "unit": "unit",
            "capacity": "capacity",
            "description": "description"
          }
        }
      ]
    }
  }
}
