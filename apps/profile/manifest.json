{
  "schema_version": 1,
  "id": "core-profile",
  "name": "Profile",
  "summary": "Who you are, in one block at the top of your page.",
  "description": "The business profile the business already keeps — name, tagline, about, address, logo and cover — as the header of the public page, with the ways to get in touch. The owner edits it here, in place.",
  "version": "1.0.0",
  "publisher": "core",
  "icon": "🪪",
  "requires": {
    "platform": "1"
  },
  "runtime": {
    "type": "engine",
    "engine": "1"
  },
  "surfaces": [
    {
      "id": "owner",
      "kind": "dashboard",
      "title": "Profile",
      "path": "/owner",
      "display_modes": [
        "page"
      ]
    },
    {
      "id": "public",
      "kind": "public",
      "title": "About",
      "path": "/public",
      "display_modes": [
        "inline",
        "card",
        "page"
      ]
    }
  ],
  "permissions": [
    {
      "id": "business:read",
      "reason": "Shows the business profile: name, tagline, about, address, logo, cover and contact details."
    },
    {
      "id": "business:write",
      "reason": "Lets you edit the business profile here, in place: the same record the public page shows."
    }
  ],
  "bindings": {
    "profile": {
      "contract": "business.profile",
      "access": "read-write"
    }
  },
  "pricing": {
    "model": "free"
  },
  "ui": {
    "sources": {
      "business_profile": {
        "from": "business",
        "binding": "profile",
        "label": "Profile",
        "labelSingular": "Profile",
        "fields": [
          {
            "key": "name",
            "label": "Name",
            "type": "text",
            "required": true,
            "maxLength": 120
          },
          {
            "key": "subtitle",
            "label": "Tagline",
            "type": "text",
            "maxLength": 160
          },
          {
            "key": "description",
            "label": "About",
            "type": "longtext",
            "maxLength": 2000
          },
          {
            "key": "address_line_1",
            "label": "Address",
            "type": "text",
            "maxLength": 160
          },
          {
            "key": "address_display",
            "label": "Address as shown",
            "type": "text",
            "readOnly": true,
            "help": "The address on one line, as the page shows it."
          },
          {
            "key": "logo_url",
            "label": "Logo",
            "type": "image"
          },
          {
            "key": "hero_image_url",
            "label": "Cover photo",
            "type": "image"
          },
          {
            "key": "phone",
            "label": "Phone",
            "type": "phone"
          },
          {
            "key": "email",
            "label": "Email",
            "type": "email"
          },
          {
            "key": "website_url",
            "label": "Website",
            "type": "url"
          },
          {
            "key": "booking_url",
            "label": "Booking link",
            "type": "url"
          },
          {
            "key": "directions_url",
            "label": "Directions link",
            "type": "url"
          }
        ],
        "title": "name"
      }
    },
    "views": {
      "owner": [
        {
          "type": "profile-editor",
          "source": "business_profile",
          "fields": {
            "location": "address_display"
          }
        }
      ],
      "public": [
        {
          "type": "profile",
          "source": "business_profile",
          "style": "card",
          "fields": {
            "name": "name",
            "tagline": "subtitle",
            "description": "description",
            "location": "address_display",
            "image": "logo_url",
            "cover": "hero_image_url",
            "phone": "phone",
            "email": "email",
            "link": "website_url",
            "book": "booking_url",
            "directions": "directions_url"
          }
        }
      ]
    }
  }
}
