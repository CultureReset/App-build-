{
  "schema_version": 1,
  "id": "core-social-links",
  "name": "Social Links",
  "summary": "Every profile you keep, in one compact row.",
  "description": "All the places people can follow you, in a row that sits under your name rather than eating a whole section.",
  "version": "1.0.0",
  "publisher": "core",
  "icon": "🌐",
  "requires": {
    "platform": "1"
  },
  "runtime": {
    "type": "engine",
    "engine": "1"
  },
  "surfaces": [
    {
      "id": "owner",
      "kind": "dashboard",
      "title": "Manage",
      "path": "/owner",
      "display_modes": [
        "page"
      ]
    },
    {
      "id": "public",
      "kind": "public",
      "title": "Elsewhere",
      "path": "/public",
      "display_modes": [
        "inline",
        "card",
        "page"
      ]
    }
  ],
  "permissions": [
    {
      "id": "business:read",
      "reason": "Shows the social profiles and links the business keeps."
    },
    {
      "id": "business:write",
      "reason": "Lets the owner add and reorder links from inside this app."
    }
  ],
  "bindings": {
    "links": {
      "contract": "business.links",
      "access": "read-write"
    }
  },
  "pricing": {
    "model": "free"
  },
  "ui": {
    "sources": {
      "profiles": {
        "from": "business",
        "binding": "links",
        "label": "Profiles",
        "labelSingular": "Profile",
        "fields": [
          {
            "key": "network",
            "label": "Network",
            "type": "text",
            "required": true,
            "maxLength": 40,
            "help": "Instagram, Facebook, your website…"
          },
          {
            "key": "url",
            "label": "Link",
            "type": "url",
            "required": true
          }
        ],
        "title": "network",
        "subtitle": "url"
      }
    },
    "views": {
      "owner": [
        {
          "type": "collection",
          "source": "profiles"
        }
      ],
      "public": [
        {
          "type": "links",
          "source": "profiles",
          "style": "icons",
          "fields": {
            "label": "network",
            "link": "url"
          }
        }
      ]
    }
  }
}
