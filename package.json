{
  "name": "modular-app-ecosystem",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --no-warnings --import ./tests/register-alias.mjs --test tests/*.test.ts",
    "seed:modules": "node --experimental-strip-types --no-warnings --import ./tests/register-alias.mjs scripts/generate-module-seed.ts",
    "seed:layouts": "node --experimental-strip-types --no-warnings --import ./tests/register-alias.mjs scripts/generate-layout-seed.ts",
    "seed": "npm run seed:modules && npm run seed:layouts",
    "db:test": "bash scripts/db-test.sh"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.45",
    "@ai-sdk/google": "^4.0.57",
    "@ai-sdk/openai": "^4.0.51",
    "@ai-sdk/openai-compatible": "^3.0.40",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "ai": "^7.0.84",
    "next": "^16.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.3"
  }
}
