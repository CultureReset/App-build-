{
  "name": "@nextgent/app-engine",
  "version": "1.0.0",
  "description": "An app is a manifest drawn by one shared runtime: manifest validator, block renderers (data, React, HTML) and a gcr-api-clean data adapter. No dependencies.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CultureReset/App-build-.git",
    "directory": "packages/engine"
  },
  "homepage": "https://github.com/CultureReset/App-build-/tree/main/packages/engine#readme",
  "bugs": {
    "url": "https://github.com/CultureReset/App-build-/issues"
  },
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./react": {
      "types": "./src/react.d.ts",
      "default": "./src/react.js"
    },
    "./html": {
      "types": "./src/index.d.ts",
      "default": "./src/html.js"
    },
    "./styles.css": "./src/styles.css"
  },
  "files": [
    "src",
    "README.md"
  ],
  "sideEffects": [
    "./src/styles.css"
  ],
  "scripts": {
    "test": "node --test 'test/*.test.js'",
    "prepack": "npm run check:store-rules && node --test 'test/*.test.js'",
    "sync:store-rules": "node scripts/sync-store-rules.mjs",
    "check:store-rules": "node scripts/sync-store-rules.mjs --check"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
